{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "6lowStick synthetic alert research record v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "source", "event", "areaCodes", "issuedAt", "expiresAt", "provenance", "drill"],
  "properties": {
    "schema": {"const": "6lowstick.alert-research.v0"},
    "id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "source": {"enum": ["synthetic-same"]},
    "event": {"type": "string", "pattern": "^[A-Z0-9]{3}$"},
    "areaCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{6}$"}},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "provenance": {"const": "unverified synthetic SAME; local gateway HMAC only"},
    "drill": {"const": true}
  }
}
